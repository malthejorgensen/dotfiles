{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Right Shift: Escape on release if pressed alone (no timeout), Shift with other keys",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "right_shift",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "set_variable": {
                                            "name": "right_shift_pressed_alone",
                                            "value": true
                                        }
                                    },
                                    { "key_code": "right_shift", "lazy": true }
                                ],
                                "to_if_other_key_pressed": [
                                    {
                                        "other_keys": [
                                            {
                                                "any": "key_code",
                                                "modifiers": { "optional": ["any"] }
                                            },
                                            {
                                                "any": "consumer_key_code",
                                                "modifiers": { "optional": ["any"] }
                                            }
                                        ],
                                        "to": [
                                            {
                                                "set_variable": {
                                                    "name": "right_shift_pressed_alone",
                                                    "value": false
                                                }
                                            },
                                            { "key_code": "right_shift" }
                                        ]
                                    }
                                ],
                                "to_after_key_up": [
                                    {
                                        "key_code": "escape",
                                        "conditions": [
                                            {
                                                "type": "variable_if",
                                                "name": "right_shift_pressed_alone",
                                                "value": true
                                            }
                                        ]
                                    },
                                    {
                                        "set_variable": {
                                            "name": "right_shift_pressed_alone",
                                            "value": false
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Emacs: Alt+B/Alt+F to word forward/backward",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "b",
                                    "modifiers": { "mandatory": ["left_option"] }
                                },
                                "to_if_alone": [
                                    {
                                        "key_code": "left_arrow",
                                        "modifiers": ["left_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "f",
                                    "modifiers": { "mandatory": ["left_option"] }
                                },
                                "to_if_alone": [
                                    {
                                        "key_code": "right_arrow",
                                        "modifiers": ["left_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "b",
                                    "modifiers": {
                                        "mandatory": ["right_option"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "left_arrow",
                                        "modifiers": ["right_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "f",
                                    "modifiers": {
                                        "mandatory": ["right_option"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "right_arrow",
                                        "modifiers": ["right_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "b",
                                    "modifiers": {
                                        "mandatory": ["right_option"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "left_arrow",
                                        "modifiers": ["right_option"]
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "d",
                                    "modifiers": {
                                        "mandatory": ["left_option"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "delete_or_backspace",
                                        "modifiers": ["left_option", "fn"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Safari: Map ESC to Cmd-. and Option-ESC",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": [
                                            "^com.apple.Safari"
                                        ],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": { "key_code": "escape" },
                                "to": [
                                    {
                                        "key_code": "period",
                                        "modifiers": ["left_gui"]
                                    },
                                    {
                                        "key_code": "escape",
                                        "modifiers": ["left_option"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Apple laptop keyboard: Right Option to Right Control",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "identifiers": [
                                            { "vendor_id": 1452 },
                                            { "vendor_id": 8349999999 }
                                        ],
                                        "type": "device_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "right_option",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "right_control" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                      "description": "New Macbook: Map right Opt to Ctrl",
                      "manipulators": [
                        {
                          "type": "basic",
                          "from": { "key_code": "right_option" },
                          "to": [{ "key_code": "right_control" }],
                          "conditions": [
                            {
                              "type": "device_if",
                              "identifiers": [{
                                  "location_id": 106
                              }]
                            }
                          ]
                        }
                      ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": {
                        "is_keyboard": true,
                        "product_id": 627,
                        "vendor_id": 1452
                    },
                    "simple_modifications": [
                        {
                            "from": { "key_code": "right_option" },
                            "to": [{ "key_code": "right_control" }]
                        }
                    ]
                },
                {
                    "identifiers": {
                        "is_keyboard": true,
                        "product_id": 834,
                        "vendor_id": 1452
                    },
                    "simple_modifications": [
                        {
                            "from": { "key_code": "right_option" },
                            "to": [{ "key_code": "right_control" }]
                        }
                    ]
                }
                // New Macbook Pro keyboard
                //
                // Solution A
                // - the below doesn't work as the `is_apple`/`is_built_in_keyboard`/`location_id`
                //   aren't actual identifiers that can be matched on. You can see this in the
                //   Karabiner-Elements EventViewer -- they do show, but not in the
                // `identifiers`-object.
                // {
                //     "identifiers": {
                //         // "is_apple": true, // <-- Karabiner does not do matching on this property
                //         // "is_built_in_keyboard": true // <-- Karabiner _does_ do matching on this property, but it doesn't work in this case
                //         // "location_id": 106
                //     },
                //     "simple_modifications": [
                //         {
                //             "from": { "key_code": "right_option" },
                //             "to": [{ "key_code": "right_control" }]
                //         }
                //     ]
                // }
                // Solution B
                // - does work, but likely applies to any keyboard -- including external ones
                //   which is exactly what we _don't_ want as those have a Ctrl-button on the
                //   right-hand side already.
                // {
                //     "identifiers": { "is_keyboard": true },
                //     "simple_modifications": [
                //         {
                //             "from": { "key_code": "right_option" },
                //             "to": [{ "key_code": "right_control" }]
                //         }
                //     ]
                // }
                // Solution C
                // - use the "New Macbook: Map right Opt to Ctrl" in `complex_modifications`.
            ],
            "fn_function_keys": [
                {
                    "from": { "key_code": "f5" },
                    "to": [{ "apple_vendor_top_case_key_code": "illumination_down" }]
                },
                {
                    "from": { "key_code": "f6" },
                    "to": [{ "apple_vendor_top_case_key_code": "illumination_up" }]
                }
            ],
            "name": "Default profile",
            "selected": true,
            "simple_modifications": [
                {
                    "from": { "key_code": "caps_lock" },
                    "to": [{ "key_code": "delete_or_backspace" }]
                }
            ],
            "virtual_hid_keyboard": {
                "country_code": 0,
                "keyboard_type_v2": "ansi"
            }
        }
    ]
}
