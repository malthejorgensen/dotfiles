#!/bin/sh

### git lfs BEGIN ###
# Run LFS only when the repository's indexed attributes contain LFS tracking rules.
if git grep --cached -I -q -E '^[^#]*[[:space:]]filter=lfs([[:space:]]|$)' -- .gitattributes ':(glob)**/.gitattributes'; then
    command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository tracks files with Git LFS but 'git-lfs' was not found on your path. Install Git LFS to run the post-merge hook."; exit 2; }
    git lfs post-merge "$@"
fi
### git lfs END ###
